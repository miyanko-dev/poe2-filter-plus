{
  "manifest_version": 3,
  "name": "PoE 2 Trading Plus",
  "version": "1.0.0",
  "description": "Fuzzy stat search, item copy, value-populated stat search, filter duplication, and item import. Verified for PoE 2 Patch 0.5.0.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pathofexile.com/trade2/search/poe2/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
